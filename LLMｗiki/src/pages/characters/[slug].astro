---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { elementClass, elementSymbols, sitePath } from '../../lib/site';
import type { CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  const characters = await getCollection('characters');
  return characters.map(character => ({ params: { slug: character.id }, props: { character } }));
}
interface Props { character: CollectionEntry<'characters'>; }
const { character } = Astro.props;
const { Content } = await render(character);
const data = character.data;
const all = await getCollection('characters');
const linked = data.relations.map(link => ({ link, target: all.find(c => c.id === link.slug) })).filter(item => item.target);
---
<BaseLayout title={data.name} description={data.summary}>
  <div class="shell character-page">
    <nav class="breadcrumbs" aria-label="階層導覽"><a href={sitePath()}>角色圖鑑</a><span aria-hidden="true">/</span><span>{data.name}</span></nav>
    <div class="character-hero">
      <div class={`character-portrait ${elementClass[data.element]}`} aria-label={`${data.element}元素抽象圖樣，非角色官方立繪`} role="img"><span class="portrait-ring ring-one"></span><span class="portrait-ring ring-two"></span><span class="portrait-symbol">{elementSymbols[data.element]}</span><span class="portrait-caption">ELEMENT · {data.element}</span></div>
      <div class="character-info">
        <span class="eyebrow"><span class="eyebrow-dash"></span> CHARACTER FILE / {character.id.toUpperCase()}</span>
        <h1>{data.name}</h1><p class="character-tagline">{data.tagline}</p>
        <div class="rarity">{'★'.repeat(data.rarity)}</div>
        <p class="character-summary">{data.summary}</p>
        <dl class="character-facts">
          <div><dt>元素</dt><dd>{elementSymbols[data.element]} {data.element}</dd></div>
          <div><dt>武器</dt><dd>{data.weapon}</dd></div>
          <div><dt>國度</dt><dd>{data.region}</dd></div>
          <div><dt>資料狀態</dt><dd>{data.status === 'verified' ? '已核對' : '待擴充核對'}</dd></div>
        </dl>
        {data.affiliation && <p class="muted-small">所屬：{data.affiliation}</p>}
      </div>
    </div>
    <div class="detail-columns">
      <article class="wiki-prose">
        <div class="section-topline"><span>02 / THE STORY</span><span>WIKI ENTRY</span></div>
        {data.spoilers && <aside class="spoiler-warning">注意：以下內容包含主要劇情劇透。</aside>}
        <Content />
      </article>
      <aside class="detail-sidebar">
        <div class="aside-panel"><h2>人物關聯</h2>
          {linked.length > 0 ? <ul class="relation-list">{linked.map(({ link, target }) => <li><a href={sitePath(`characters/${target!.id}/`)}><span>✧ {target!.data.name}</span><small>{link.label} ↗</small></a></li>)}</ul> : <p>尚未建立關聯角色。</p>}
        </div>
        <div class="aside-panel"><h2>參考來源</h2><ul class="sources-list">{data.sources.map(s => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><small>查閱：{s.checkedAt}</small></li>)}</ul><p class="sources-disclaimer">示範資料屬初步整理，請以官方原始資訊為準。</p></div>
        <p class="updated-at">Wiki 編修：{data.updatedAt}</p>
      </aside>
    </div>
    <a class="back-link" href={sitePath()}>← 返回角色圖鑑</a>
  </div>
</BaseLayout>
